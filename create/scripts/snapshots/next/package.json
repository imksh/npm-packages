    "lenis": "^1.1.3",
    "lottie-react": "^2.4.0",
    "lucide-react": "^0.470.0",
    "next": "^16.3.0",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^4.11.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "dpdm": "^3.14.0",
