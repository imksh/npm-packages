{
  "name": "node-prisma-template",
  "version": "1.0.0",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write \"src/**/*.{js,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,json}\"",
    "circular-check": "dpdm --circular --no-warning --no-tree --exit-code circular:1 \"src/**/*.js\"",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "generate:vapid": "node ./src/utils/generateVapidKeys.js"
  },
  "dependencies": {
    "@prisma/client": "^7.0.0",
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.4",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "cloudinary": "^2.0.0",
    "nodemailer": "^6.9.7",
    "socket.io": "^4.7.2",
    "web-push": "^3.6.6",
    "pg": "^8.11.3",
    "@prisma/adapter-pg": "^7.0.0",
    "expo-server-sdk": "^3.10.0",
    "google-auth-library": "^9.14.2"
  },
  "devDependencies": {
    "dpdm": "^3.14.0",
    "eslint": "^8.53.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.4.2",
    "prisma": "^7.0.0"
  }
}