model Attachment {
  id        String          @id @default(uuid())
  provider  StorageProvider
  publicId  String // Cloudinary public_id, S3 key, or local path
  url       String
  fileName  String
  mimeType  String
  extension String
  size      Int // File size in bytes
  type      AttachmentType
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?
}
